# Internal HTTP gateway: one origin for the whole app. "/api/*" is routed to the
# backend and everything else to the frontend. TLS is handled by the operator's
# own reverse proxy placed in front of this service in production.
:80 {
	handle /api/* {
		reverse_proxy api:8000 {
			# Overwrite instead of appending: the default behaviour keeps whatever
			# the caller sent, and the backend rate limiter reads this header to
			# identify a client. A caller-supplied entry must never survive here.
			# If you run another proxy in front of this gateway, replace this with
			# that proxy's own client address.
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}
	handle {
		reverse_proxy web:3000
	}
}
