# PostgreSQL inside Docker. Use only letters and numbers in the password so the URL stays valid.
POSTGRES_DB=openlivery
POSTGRES_TEST_DB=openlivery_test
POSTGRES_USER=openlivery
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

# Secrets unique to this installation. Do not reuse values across installations.
# The API refuses to start while any of them still holds one of these
# placeholders — run ./scripts/generate-docker-env.sh to fill them in.
SECRET_KEY=CHANGE_THIS_SESSION_SECRET
ENCRYPTION_KEY=CHANGE_THIS_ENCRYPTION_KEY
WHATSAPP_BRIDGE_TOKEN=CHANGE_THIS_INTERNAL_TOKEN

# The app and API are served from one origin through the gateway, so the browser
# uses relative "/api" calls — there is no public API URL to configure.
#
# FRONTEND_URL is different: it is the public URL of this deployment, the one
# someone reaches the app at from outside. Besides CORS, it builds two links
# that have to work from another machine — the one for accepting an invitation,
# and the webhook URL you paste into Meta's dashboard. Leaving it at the default
# fails silently: both come out pointing at localhost. Change it together with
# WEB_PORT.
FRONTEND_URL=http://localhost:3000

# Optional configuration.
ACCESS_TOKEN_MINUTES=10080
WHATSAPP_LOG_LEVEL=silent
# The instance is single-agency by default: the first registration creates the
# owner agency and closes public sign-up. Set to true only when one deployment
# must host many agencies.
# ALLOW_MULTI_AGENCY=false

# Session cookie flags. Behind an HTTPS reverse proxy set COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Portal invitation e-mails. "none" (the default) sends nothing: the
# invitation is still created and the accept link comes back in the API
# response for an admin to relay by hand. Set EMAIL_PROVIDER=smtp and fill in
# the SMTP_* values below to send it for real.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_STARTTLS=true
# Minutes an invitation link stays valid (24h default).
# INVITATION_TOKEN_MINUTES=1440

# Native error log retention (app/services/error_log.py): rows older than this
# many days, or beyond this row cap (whichever hits first), are purged by an
# hourly background sweep. 0 disables that particular limit; both at 0 stops
# the purge entirely.
# ERROR_LOG_RETENTION_DAYS=30
# ERROR_LOG_MAX_ROWS=5000

# Host ports. Change any that clash with other local services. WEB_PORT is the
# gateway (the app); API_PORT exposes the API locally for docs/tooling.
API_PORT=8000
WEB_PORT=3000
DB_PORT=5432
# Bind address: 127.0.0.1 (local only) or 0.0.0.0 (expose on a server).
BIND_HOST=127.0.0.1

# Resource ceilings per container. These are limits, not reservations: nothing
# is held aside, and a container only feels them under real pressure. They exist
# so one runaway service cannot take the whole host down with it.
#
# Raise them here rather than editing docker-compose.yml. If a container is
# killed with exit code 137, it hit its memory ceiling — that is the number to
# raise, and the API is the one to watch when a knowledge base grows.
# DB_MEMORY_LIMIT=1g
# DB_CPU_LIMIT=1.0
# API_MEMORY_LIMIT=1g
# API_CPU_LIMIT=2.0
# WEB_MEMORY_LIMIT=512m
# WEB_CPU_LIMIT=1.0
# WHATSAPP_MEMORY_LIMIT=512m
# WHATSAPP_CPU_LIMIT=1.0
# PROXY_MEMORY_LIMIT=128m
# PROXY_CPU_LIMIT=0.5

# How many days image and voice-note binaries are kept. message_attachments is
# the only table that grows without a ceiling as the product is used. 0 deletes
# nothing, which is the default on purpose: upgrading must never start deleting
# data for someone who did not ask for it. The message keeps its text either
# way; only the original file goes.
# ATTACHMENT_RETENTION_DAYS=0
